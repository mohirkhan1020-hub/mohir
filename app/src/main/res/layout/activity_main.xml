<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- WhatsApp হেডার -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#202C33"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:textColor="#E9EDEF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wa_reply_bar"
                android:hint="Search..."
                android:paddingHorizontal="12dp"
                android:textColor="#E9EDEF"
                android:textColorHint="#8696A0"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="#00000000"
                android:padding="0dp"
                android:text="🔍"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnProfileEdit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="#00000000"
                android:padding="0dp"
                android:text="⚙️"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- ৩টি ট্যাব: CHATS | STATUS | CALLS -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#202C33"
            app:tabIndicatorColor="#00A884"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="#00A884"
            app:tabTextColor="#8696A0" />

        <!-- ট্যাব কনটেন্ট -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChats"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/statusContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnMyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_wa_circle_gray"
                            android:gravity="center"
                            android:text="📷"
                            android:textSize="20sp" />
                        <TextView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_wa_circle_green"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Status"
                            android:textColor="#E9EDEF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to add status update"
                            android:textColor="#8696A0"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="Recent updates"
                    android:textColor="#8696A0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStatuses"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ফ্লোটিং অ্যাকশন বাটন -->
    <Button
        android:id="@+id/fabAction"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_wa_circle_green"
        app:backgroundTint="@null"
        android:text="💬"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <!-- হোম স্ক্রিনে ইনকামিং কল পপআপ -->
    <FrameLayout
        android:id="@+id/incomingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B141A"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#202C33"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_wa_circle_green"
                android:gravity="center"
                android:text="📞"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvCallerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Friend"
                android:textColor="#E9EDEF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCallType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Incoming WhatsApp call..."
                android:textColor="#8696A0"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRejectCall"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:backgroundTint="#EF4444"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnAcceptCall"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="34dp"
                    android:backgroundTint="#00A884"
                    android:text="📞"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>