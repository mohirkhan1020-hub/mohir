<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/msgRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="3dp">

    <TextView
        android:id="@+id/tvDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:background="@drawable/bg_wa_date_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="Today"
        android:textColor="#8696A0"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="295dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvForwarded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="↪ Forwarded"
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textColor="#25D366"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/replyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_wa_reply_bar"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingVertical="6dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvReplyQuoteSender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#25D366" android:textSize="11.5sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvReplyQuoteText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#B0BEC5" android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMedia"
            android:layout_width="225dp"
            android:layout_height="225dp"
            android:layout_marginBottom="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/RoundedImage" />

        <!-- Document / File Box -->
        <LinearLayout
            android:id="@+id/fileBox"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_wa_reply_bar"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:visibility="gone">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_file" />
            <TextView android:id="@+id/tvFileName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="document.pdf" android:textColor="#E9EDEF" android:textSize="13sp" />
        </LinearLayout>

        <!-- Location Box -->
        <LinearLayout
            android:id="@+id/locationBox"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_wa_reply_bar"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:visibility="gone">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_location" />
            <TextView android:id="@+id/tvLocationLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="📍 Shared Location\nTap to view on Google Maps" android:textColor="#E9EDEF" android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceBox"
            android:layout_width="215dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">
            <ImageButton android:id="@+id/btnPlayVoice" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_wa_circle_green" android:src="@drawable/ic_play" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progress="45" android:progressBackgroundTint="#4DFFFFFF" android:progressTint="#25D366" />
                <TextView android:id="@+id/tvVoiceLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0:05" android:textColor="#B0BEC5" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/tvMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E9EDEF" android:textSize="15sp" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="2dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:30 PM" android:textColor="#99FFFFFF" android:textSize="10.5sp" />
            <ImageView android:id="@+id/ivTicks" android:layout_width="15dp" android:layout_height="15dp" android:layout_marginStart="4dp" android:src="@drawable/ic_done_all" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tvReaction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-7dp" android:background="@drawable/bg_wa_badge" android:paddingHorizontal="7dp" android:paddingVertical="2dp" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>