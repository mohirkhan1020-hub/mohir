<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/msgRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="285dp"
        android:orientation="vertical"
        android:padding="9dp">

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textColor="#00A884"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Reply Quote বক্স -->
        <LinearLayout
            android:id="@+id/replyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_wa_reply_bar"
            android:orientation="vertical"
            android:padding="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReplyQuoteSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00A884"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReplyQuoteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ছবি -->
        <ImageView
            android:id="@+id/ivMedia"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- ভয়েস নোট প্লেয়ার -->
        <LinearLayout
            android:id="@+id/voiceBox"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPlayVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:backgroundTint="#00A884"
                android:padding="0dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvVoiceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="🎤 Voice Note"
                android:textColor="#E9EDEF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- টেক্সট মেসেজ -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E9EDEF"
            android:textSize="14.5sp" />

        <!-- সময় ও ডাবল টিক -->
        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="10:30 PM ✓✓"
            android:textColor="#99FFFFFF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- ইমোজি রিঅ্যাকশন ব্যাজ -->
    <TextView
        android:id="@+id/tvReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:background="@drawable/bg_wa_badge"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>