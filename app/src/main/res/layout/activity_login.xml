<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wa_call_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_wa_circle_green"
        android:gravity="center"
        android:text="💬"
        android:textSize="38sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Welcome to WhatsApp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Enter your mobile number and display name.\nPrivate, fast &amp; no OTP required."
        android:textColor="#8696A0"
        android:textSize="13.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="#121B22"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE NUMBER"
            android:textColor="#25D366"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_wa_input"
            android:hint="e.g. 96550123456 or 01712345678"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="#E9EDEF"
            android:textColorHint="#667781"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="YOUR NAME"
            android:textColor="#25D366"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_wa_input"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#E9EDEF"
            android:textColorHint="#667781"
            android:textSize="15sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#25D366"
        android:text="AGREE AND CONTINUE"
        android:textColor="#0B141A"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>