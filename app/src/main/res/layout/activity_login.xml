<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="Welcome to WhatsApp"
        android:textColor="#E9EDEF"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Enter your mobile number and name to continue.\nNo OTP required."
        android:textColor="#8696A0"
        android:textSize="13.5sp" />

    <TextView
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_wa_circle_green"
        android:gravity="center"
        android:text="💬"
        android:textSize="34sp" />

    <EditText
        android:id="@+id/etLoginPhone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_wa_input"
        android:hint="Mobile Number (e.g. 96550123456 or 017...)"
        android:inputType="phone"
        android:paddingHorizontal="18dp"
        android:textColor="#E9EDEF"
        android:textColorHint="#8696A0"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etLoginName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_wa_input"
        android:hint="Your Name (e.g. Mohir)"
        android:inputType="textPersonName"
        android:paddingHorizontal="18dp"
        android:textColor="#E9EDEF"
        android:textColorHint="#8696A0"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00A884"
        android:text="AGREE AND CONTINUE"
        android:textColor="#0B141A"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>