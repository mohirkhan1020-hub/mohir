<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wa_chat_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:background="#1F2C34" android:gravity="center_vertical" android:paddingHorizontal="6dp" android:elevation="4dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" />
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
                <TextView android:id="@+id/tvChatAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_wa_circle_gray" android:gravity="center" android:text="A" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivChatAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" app:shapeAppearanceOverlay="@style/CircleImage" />
                <View android:id="@+id/viewChatOnline" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_wa_online_dot" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvChatName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Friend" android:textColor="#E9EDEF" android:textSize="16.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvChatStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="online" android:textColor="#25D366" android:textSize="12sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnVideoCall" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_videocam" />
            <ImageButton android:id="@+id/btnAudioCall" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_calls" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingVertical="8dp" />

        <LinearLayout android:id="@+id/replyPreviewLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_wa_reply_bar" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingVertical="8dp" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvReplySender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#25D366" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvReplyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#B0BEC5" android:textSize="13sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnCancelReply" android:layout_width="30dp" android:layout_height="30dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout android:id="@+id/recordingBar" android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="8dp" android:background="@drawable/bg_wa_input" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:visibility="gone">
            <TextView android:id="@+id/tvRecordTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔴 Recording 00:00" android:textColor="#EF4444" android:textSize="14sp" android:textStyle="bold" />
            <Button android:id="@+id/btnCancelRecord" android:layout_width="wrap_content" android:layout_height="36dp" android:backgroundTint="#2A3942" android:text="Cancel" android:textColor="#FFFFFF" android:textSize="12sp" />
            <Button android:id="@+id/btnSendRecord" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:backgroundTint="#00A884" android:text="Send" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/inputRowLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:padding="7dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_wa_input" android:gravity="center_vertical" android:paddingHorizontal="6dp" android:paddingVertical="3dp">
                <ImageButton android:id="@+id/btnEmoji" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_emoji" />
                <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:hint="Message" android:maxLines="4" android:padding="8dp" android:textColor="#E9EDEF" android:textColorHint="#8696A0" android:textSize="15.5sp" />
                <ImageButton android:id="@+id/btnAttach" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_attach" />
                <ImageButton android:id="@+id/btnCamQuick" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_camera" app:tint="#8696A0" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnSendOrMic" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/bg_wa_circle_green" android:src="@drawable/ic_mic" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/incomingOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_wa_call_bg" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="84dp">
            <TextView android:id="@+id/tvCallType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsApp voice call" android:textColor="#25D366" android:textSize="14sp" />
            <TextView android:id="@+id/tvCallerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="🔒 End-to-end encrypted" android:textColor="#8696A0" android:textSize="12.5sp" />
            <TextView android:layout_width="130dp" android:layout_height="130dp" android:layout_marginTop="54dp" android:background="@drawable/bg_wa_circle_gray" android:gravity="center" android:text="👤" android:textSize="58sp" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="60dp" android:gravity="center">
                <ImageButton android:id="@+id/btnRejectCall" android:layout_width="70dp" android:layout_height="70dp" android:background="@drawable/bg_wa_circle_green" android:backgroundTint="#EF4444" android:src="@drawable/ic_call_end" />
                <ImageButton android:id="@+id/btnAcceptCall" android:layout_width="70dp" android:layout_height="70dp" android:layout_marginStart="80dp" android:background="@drawable/bg_wa_circle_green" android:backgroundTint="#25D366" android:src="@drawable/ic_calls" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/callOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_wa_call_bg" android:visibility="gone">
        <org.webrtc.SurfaceViewRenderer android:id="@+id/remoteVideoView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/audioCallAvatarBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="140dp" android:layout_height="140dp" android:background="@drawable/bg_wa_circle_gray" android:gravity="center" android:text="👤" android:textSize="60sp" />
        </LinearLayout>
        <org.webrtc.SurfaceViewRenderer android:id="@+id/localVideoView" android:layout_width="match_parent" android:layout_height="match_parent" />

        <LinearLayout android:id="@+id/callTopBar" android:layout_width="match_parent" android:layout_height="88dp" android:background="#80000000" android:gravity="center_vertical" android:paddingHorizontal="16dp">
            <ImageButton android:id="@+id/btnMinimize" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_minimize" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒 End-to-end encrypted" android:textColor="#B0BEC5" android:textSize="11sp" />
                <TextView android:id="@+id/tvActiveTarget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvCallTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calling..." android:textColor="#25D366" android:textSize="13sp" />
            </LinearLayout>
            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <ImageButton android:id="@+id/btnMaximize" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/bg_wa_circle_gray" android:src="@drawable/ic_minimize" android:visibility="gone" />

        <LinearLayout android:id="@+id/callBottomBar" android:layout_width="wrap_content" android:layout_height="72dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="28dp" android:background="@drawable/bg_wa_call_dock" android:elevation="8dp" android:gravity="center" android:paddingHorizontal="14dp">
            <ImageButton android:id="@+id/btnSpeaker" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_wa_circle_gray" android:src="@drawable/ic_volume" />
            <ImageButton android:id="@+id/btnCam" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_wa_circle_gray" android:src="@drawable/ic_videocam" />
            <ImageButton android:id="@+id/btnSwitchCam" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_wa_circle_gray" android:src="@drawable/ic_flip_cam" />
            <ImageButton android:id="@+id/btnScreenShare" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_wa_circle_gray" android:src="@drawable/ic_screen_share" />
            <ImageButton android:id="@+id/btnMic" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_wa_circle_gray" android:src="@drawable/ic_mic" />
            <ImageButton android:id="@+id/btnHangup" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="10dp" android:background="@drawable/bg_wa_circle_green" android:backgroundTint="#EF4444" android:src="@drawable/ic_call_end" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>